{
  "themeId": "redgate-lodge-bespoke",
  "version": 1,
  "description": "Per-component text fields for the redgate-lodge-bespoke theme (warm-premium 'guest house for cars'). The dashboard /create + /update pages render form inputs per field. The AI brand generator reads this recipe to know what copy to emit. The theme runtime reads brand.text[<key>] first, then the recipe default below (with token interpolation). Voice: warm — first-person plural, hospitable, concrete; no exclamation marks, no 'luxury'/'exclusive', no urgency pressure.",
  "tokens": {
    "{brandName}": "Resolved brand name (or 'the showroom')",
    "{city}": "Brand city — empty if absent",
    "{county}": "Brand county",
    "{cityish}": "city || county || 'the showroom'",
    "{streetLine}": "line1 + line2 of address",
    "{postcode}": "Brand postcode",
    "{year}": "Current year",
    "{tagline}": "brand.tagline"
  },
