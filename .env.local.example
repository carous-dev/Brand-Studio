# Commit-safe local env template.
# Copy this file to `.env.local` for Next.js or `.env` for shared local tooling.

# App runtime
NODE_ENV=development
PORT=3000
FLASK_API_URL=http://localhost:5000/api
NEXT_PUBLIC_FLASK_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_PREVIEW=1

# Optional brand override for single-tenant local testing
# NEXT_PUBLIC_BRAND=brand-slug

# Public brand/support UI defaults
NEXT_PUBLIC_COMPANY_NAME=Your Dealership Name
NEXT_PUBLIC_SUPPORT_AGENT_AVATAR=/images/brand-logo.png
NEXT_PUBLIC_SUPPORT_AGENT_NAME=Support
NEXT_PUBLIC_SUPPORT_TIMEZONE=Europe/London
NEXT_PUBLIC_SUPPORT_WS_URL=ws://localhost:4001
NEXT_PUBLIC_LEADS_API_URL=
NEXT_PUBLIC_CAROUS_LOOKUP_API_URL=https://api.carous.co.uk/v1/lookup

# Caching
BRAND_CACHE_TTL_MS=0
BRAND_API_CACHE_TTL_MS=0

# Database for Next.js server code
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=dealers_previews

# Database for Flask/services/scripts
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=dealers_previews
MYSQL_PORT=3306

# Online checker
ONLINE_CHECKER_AUTO_START=true

# Sync/API auth
SYNC_API_KEY=replace_with_strong_api_key

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=replace_with_smtp_password
SMTP_FROM=you@example.com
SMTP_FROM_NAME=Your Dealership Name

# Ollama
OLLAMA_API=http://127.0.0.1:11434
OLLAMA_CHAT_ENDPOINT=http://127.0.0.1:11434/api/chat
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TEMPERATURE=0.25
OLLAMA_MAX_TOKENS=512

# OpenAI
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=gpt-4.1-mini

# Support assistant
SUPPORT_SYSTEM_PROMPT=You are a helpful dealership support assistant.

# Cloudflare automation (optional)
CLOUDFLARE_DISABLED=true
CLOUDFLARE_API_TOKEN=replace_with_cloudflare_api_token
CLOUDFLARE_ZONE_ID=replace_with_cloudflare_zone_id
CLOUDFLARE_IP_ADDRESS=127.0.0.1
CLOUDFLARE_DEFAULT_CERT_FILE=/etc/ssl/cloudflare/cloudflare-cert.pem
CLOUDFLARE_DEFAULT_KEY_FILE=/etc/ssl/cloudflare/cloudflare-key.pem
CLOUDFLARE_ORIGIN_CERT_TEMPLATE=/etc/ssl/cloudflare/{origin}-origin.pem
CLOUDFLARE_ORIGIN_KEY_TEMPLATE=/etc/ssl/cloudflare/{origin}-origin.key

# Deployment/process management (optional)
APP_ENV=development
ENV=development
FLASK_ENV=development
NEXT_INTERNAL_PORT=3000
SUPPORT_WS_PORT=4001
PM2_NEXT_APP_NAME=preview-builder
PM2_RESTART_DISABLED=false
BRAND_AUTOMATION_DISABLED=false
PREVIEW_DEBUG_LOGS=false
DNS_POLL_INTERVAL=5
DNS_POLL_TIMEOUT=15
DNS_VALIDATE_TIMEOUT=10
MANAGED_VHOST_TEMPLATE_DIR=./managed_vhost_templates
APACHE_VHOST_TEMPLATE_SOURCE=./managed_vhost_templates/carouspreviews_co_uk.vhost_template.conf
APACHE_VHOST_TEMPLATE=./managed_vhost_templates/carouspreviews_co_uk.vhost_template.conf
APACHE_SITES_AVAILABLE_DIR=/etc/apache2/sites-available
APACHE_SITES_ENABLED_DIR=/etc/apache2/sites-enabled
