{
  "name": "preview-builder",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Preview Builder - Create, edit, and preview dealership brand sites (Next.js + Flask + SQLite).",
  "keywords": [
    "preview-builder",
    "brand-builder",
    "brand-preview",
    "dealership",
    "used-cars",
    "multi-tenant",
    "nextjs",
    "flask",
    "sqlite"
  ],
  "author": "Carous Limited",
  "scripts": {
    "theme:sync": "node tools/sync-theme-contracts.mjs",
    "check:contract": "node tools/check-theme-contract.mjs",
    "check:images": "node tools/check-image-contract.mjs",
    "check:media": "node tools/check-image-contract.mjs",
    "check:text": "node tools/check-text-contract.mjs",
    "check:content": "node tools/check-image-contract.mjs && node tools/check-text-contract.mjs",
    "dev": "npm run theme:sync && next dev",
    "build": "npm run theme:sync && next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@types/nodemailer": "^7.0.4",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.23.25",
    "lenis": "^1.3.25",
    "lucide-react": "^0.556.0",
    "mysql2": "^3.15.3",
    "next": "16.0.7",
    "nodemailer": "^7.0.11",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "stream-chat": "^9.27.0",
    "stream-chat-react": "^13.13.0",
    "ws": "^8.13.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.7",
    "ts-node": "^10.9.1",
    "typescript": "^5"
  }
}
